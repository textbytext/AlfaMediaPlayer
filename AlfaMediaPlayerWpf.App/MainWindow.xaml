<Window xmlns:UI="clr-namespace:AlfaMediaPlayerWpf.App.UI"  x:Class="AlfaMediaPlayerWpf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlfaMediaPlayerWpf.App"	
        mc:Ignorable="d"
		Background="#111"		
		x:Name="Root"
		KeyDown="Grid_KeyDown"
        Title="Alfa Media Player" Height="450" Width="800" MinWidth="600" MinHeight="400">
	<Grid Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto"></RowDefinition>
			<RowDefinition Height="*"></RowDefinition>
			<RowDefinition Height="auto"></RowDefinition>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3,3,3,3">
			<Button Name="OpenFileButton">
				<StackPanel Orientation="Horizontal">
					<Image Source="/images/file_open.png" Height="16"></Image>
					<TextBlock>Open File</TextBlock>
				</StackPanel>
			</Button>
			<Button Name="OpenFileListButton">
				<StackPanel Orientation="Horizontal">
					<Image Source="/images/list.png" Height="16"></Image>
					<TextBlock>History</TextBlock>
				</StackPanel>
			</Button>
		</StackPanel>

		<MediaElement Grid.Row="1" Stretch="Uniform" Name="Media" LoadedBehavior="Manual"/>

		<StackPanel Grid.Row="1" Name="TheEndPanel" VerticalAlignment="Center" HorizontalAlignment="Left">
			<TextBlock Name="TheEndText" Foreground="{StaticResource BorderColor}" TextWrapping="Wrap">!</TextBlock>
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Vertical" Name="ControlPanel">
			<TextBlock Name="FileNameLable" TextWrapping="WrapWithOverflow" FontSize="23" TextAlignment="Center">file name ...</TextBlock>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="auto"></ColumnDefinition>
					<ColumnDefinition Width="auto"></ColumnDefinition>
					<ColumnDefinition Width="auto"></ColumnDefinition>
					<ColumnDefinition Width="*"></ColumnDefinition>
					<ColumnDefinition Width="auto"></ColumnDefinition>
					<ColumnDefinition Width="auto"></ColumnDefinition>
					<ColumnDefinition Width="auto"></ColumnDefinition>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Name="PlayButton" VerticalAlignment="Top" ToolTip="Play">
					<StackPanel Orientation="Horizontal">
						<Image Source="/images/play_arrow.png" Height="16"></Image>
						<TextBlock>Play</TextBlock>
					</StackPanel>
				</Button>

				<Button Grid.Column="1" Name="PauseButton" VerticalAlignment="Top" ToolTip="Pause">
					<StackPanel Orientation="Horizontal">
						<Image Source="/images/pause.png" Height="16"></Image>
						<TextBlock>Pause</TextBlock>
					</StackPanel>
				</Button>

				<Button Grid.Column="2" VerticalAlignment="Top" Name="Dec5SecButton">
					<StackPanel Orientation="Horizontal">
						<TextBlock>-5s</TextBlock>
					</StackPanel>
				</Button>

				<StackPanel Grid.Column="3" Orientation="Vertical" Margin="5,0,5,0" HorizontalAlignment="Stretch">
					<Slider Maximum="1000" Name="MediaPositionSlider" IsMoveToPointEnabled="True"></Slider>
					<Label Name="FilePositionTime" HorizontalAlignment="Center" Padding="0">time...</Label>
				</StackPanel>

				<Button Grid.Column="4" VerticalAlignment="Top" Name="Add5SecButton">
					<StackPanel Orientation="Horizontal">
						<TextBlock>+5s</TextBlock>
					</StackPanel>
				</Button>

				<ToggleButton Grid.Column="5" VerticalAlignment="Top" Name="RepeatButton">
					<StackPanel Orientation="Horizontal">
						<Image Source="/images/cycle.png" Height="16"></Image>
						<TextBlock>Repeat</TextBlock>
					</StackPanel>
				</ToggleButton>

				<Button Grid.Column="6" Name="TimePointsButton" VerticalAlignment="Top">
					<StackPanel Orientation="Horizontal">
						<Image Source="/images/book.png" Height="16"></Image>
						<TextBlock>Marks</TextBlock>
					</StackPanel>
				</Button>
			</Grid>
		</StackPanel>


		<UI:PopupContainerControl Grid.Row="0" Grid.RowSpan="3" Title="History" Visibility="Collapsed" x:Name="FileListPopup">
			<UI:FileListControl/>
		</UI:PopupContainerControl>

		<UI:PopupContainerControl Grid.Row="0" Grid.RowSpan="3" Title="Time Points" Visibility="Collapsed" x:Name="TimePointsPopup">
			<UI:TimePointsControl></UI:TimePointsControl>
		</UI:PopupContainerControl>
	</Grid>
</Window>
