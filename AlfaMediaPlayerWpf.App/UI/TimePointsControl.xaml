<UserControl x:Class="AlfaMediaPlayerWpf.App.UI.TimePointsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlfaMediaPlayerWpf.App.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<UserControl.Resources>
		<Style x:Key="Number" TargetType="TextBox">
			<Setter Property="Width" Value="30"></Setter>
			<Setter Property="Foreground" Value="{StaticResource TextForeground}"></Setter>
			<Setter Property="Background" Value="{StaticResource TextBg}"></Setter>
			<Setter Property="VerticalAlignment" Value="Center"></Setter>
			<Setter Property="HorizontalAlignment" Value="Center"></Setter>
			<Setter Property="Padding" Value="5"></Setter>
			<Setter Property="BorderThickness" Value="0"></Setter>
			<Setter Property="FontSize" Value="14"></Setter>
		</Style>
	</UserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="auto"></RowDefinition>
			<RowDefinition Height="*"></RowDefinition>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal">
			<Button Margin="3" Click="AddButton_Click">
				<StackPanel Orientation="Horizontal">
					<Image Source="/images/add.png" Height="16"></Image>
					<TextBlock>Add</TextBlock>
				</StackPanel>
			</Button>

			<Button Margin="3" Click="SaveButton_Click">
				<StackPanel Orientation="Horizontal">
					<Image Source="/images/save.png" Height="16"></Image>
					<TextBlock>Save</TextBlock>
				</StackPanel>
			</Button>
		</StackPanel>

		<ListView Grid.Row="1" Background="Transparent" Name="TimeMarks" SelectionMode="Single" BorderThickness="0">
			<ListBox.ItemContainerStyle>
				<Style TargetType="ListBoxItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
				</Style>
			</ListBox.ItemContainerStyle>
			<ListView.ItemTemplate>
				<DataTemplate DataType="local:TimePointUI">
					<Grid>						
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="auto"></ColumnDefinition>
							<ColumnDefinition Width="auto"></ColumnDefinition>
							<ColumnDefinition Width="*"></ColumnDefinition>
							<ColumnDefinition Width="auto"></ColumnDefinition>
						</Grid.ColumnDefinitions>

						<Button Grid.Column="0" Click="PlayButton_Click">
							<StackPanel Orientation="Horizontal">
								<Image Source="/images/play_arrow.png" Height="16"></Image>
							</StackPanel>
						</Button>
						
						<StackPanel Grid.Column="1" Orientation="Horizontal">
							<TextBox Style="{DynamicResource Number}" Text="{Binding HHs}"></TextBox>
							<TextBox Style="{DynamicResource Number}" Text="{Binding mms}"></TextBox>
							<TextBox Style="{DynamicResource Number}" Text="{Binding sss}"></TextBox>
						</StackPanel>

						<TextBox Grid.Column="2" Style="{DynamicResource Number}" Text="{Binding Name}" Width="auto" HorizontalAlignment="Left"></TextBox>

						<Button Grid.Column="3" Click="DeleteButton_Click">
							<StackPanel Orientation="Horizontal">
								<Image Source="/images/delete.png" Height="16"></Image>
								<TextBlock>Delete</TextBlock>
							</StackPanel>
						</Button>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</UserControl>
