<Application x:Class="AlfaMediaPlayerWpf.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AlfaMediaPlayerWpf.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
		<SolidColorBrush x:Key="TextForeground">White</SolidColorBrush>
		<SolidColorBrush x:Key="TextBg">#111</SolidColorBrush>
		<SolidColorBrush x:Key="BorderColor">#555</SolidColorBrush>
		<SolidColorBrush x:Key="BackgroundHover">#444</SolidColorBrush>
		<SolidColorBrush x:Key="ButtonBackground">#222</SolidColorBrush>
		<Style TargetType="Label" x:Key="LabelRes">
			<Setter Property="Foreground" Value="Wheat"></Setter>
			<Setter Property="FontSize" Value="13"></Setter>
		</Style>		
		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="Wheat"></Setter>
			<Setter Property="FontSize" Value="13"></Setter>
			<Setter Property="Padding" Value="5,1,5,1"></Setter>
		</Style>
		<Style TargetType="Button">
			<Setter Property="Margin" Value="2"></Setter>
			<Setter Property="Background" Value="#222"></Setter>
			<Setter Property="BorderBrush" Value="#555"></Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" Padding="3">
							<ContentPresenter></ContentPresenter>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Cursor" Value="Hand"></Setter>
					<Setter Property="Background" Value="{StaticResource BackgroundHover}"></Setter>
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style TargetType="ToggleButton">
			<Setter Property="Margin" Value="2"></Setter>
			<Setter Property="Background" Value="{StaticResource ButtonBackground}"></Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border CornerRadius="5" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Background="{TemplateBinding Background}" Padding="3">
							<ContentPresenter></ContentPresenter>							
						</Border>						
					</ControlTemplate>
				</Setter.Value>
			</Setter>			
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Cursor" Value="Hand"></Setter>
					<Setter Property="Background" Value="{StaticResource BackgroundHover}"></Setter>
				</Trigger>
				<Trigger Property="IsChecked" Value="True">
					<Setter Property="Background" Value="#777"></Setter>
				</Trigger>				
			</Style.Triggers>
		</Style>
	</Application.Resources>
</Application>
